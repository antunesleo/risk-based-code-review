+@pytest.mark.tier(1)
+def test_list_tickets_breaks_ties_by_newest_id(client, seed_customer, seed_ticket):
+    customer = seed_customer()
+    first, second = seed_ticket(customer), seed_ticket(customer)
+
+    response = client.get("/tickets")
+
+    assert [t["id"] for t in response.json()] == [second["id"], first["id"]]
