# Test image for the helpdesk. Built from the repository root so it can install
# the tier-review pytest plugin, the same way you would install pytest-cov.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /work/helpdesk
COPY helpdesk/requirements.txt helpdesk/requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY tier-review /opt/tier-review
RUN pip install --no-cache-dir /opt/tier-review
COPY helpdesk /work/helpdesk
CMD ["pytest", "-q"]
